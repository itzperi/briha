---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Accessibility | Brihadhee, Anna Nagar, Chennai" description="Our commitment to an accessible Brihadhee website: keyboard use, readable text, clear labels, and how to tell us about a problem." path="/accessibility/" breadcrumbs={[{ name: 'Accessibility', href: '/accessibility/' }]}>
  <div class="wrap py-6 max-w-3xl prose-b" style="margin-inline:auto">
    <h1>Accessibility</h1>
    <p>We want everyone to be able to use this website. The site works with a keyboard, has visible focus outlines, readable text sizes, labelled form fields and descriptive image text.</p>
    <p>If something is hard to use, please tell us on the <a href="/contact/">contact page</a> and we will fix it.</p>
  </div>
</BaseLayout>
