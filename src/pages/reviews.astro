---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewList from '../components/ReviewList.astro';
import reviews from '../data/reviews.json';
const has = (reviews as { permission: boolean }[]).some((r) => r.permission === true);
---
<BaseLayout title="Reviews | Brihadhee, Anna Nagar, Chennai" description="What guests say about Brihadhee, W Block Main Road, 3rd Avenue, Anna Nagar, Chennai. We show only reviews shared with permission." path="/reviews/" noindex={!has} breadcrumbs={[{ name: 'Reviews', href: '/reviews/' }]}>
  <div class="wrap py-6">
    <h1>Guest reviews</h1>
    <p class="mt-3 max-w-3xl">We show only reviews that guests have given us permission to share. You can also read reviews on Google Maps and the delivery apps.</p>
    <div class="mt-6"><ReviewList /></div>
    <p class="mt-6"><a href="/menu/">Menu</a> · <a href="/location/anna-nagar/">Find us</a></p>
  </div>
</BaseLayout>
