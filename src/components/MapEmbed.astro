---
import { mapEmbedUrl, directionsUrl, fullAddress } from '../lib/facts';
import { facts } from '../data/brand-facts';
const src = mapEmbedUrl();
---
<div class="card" data-map style="min-height:320px">
  <p class="font-semibold">{facts.name}, {fullAddress()}</p>
  <div data-map-frame style="height:260px;margin-top:.75rem;border-radius:.7rem;background:var(--color-sand);display:grid;place-items:center">
    <button type="button" class="btn" data-map-load data-src={src} data-event="map_load">Show map</button>
  </div>
  <p class="mt-3"><a href={directionsUrl()} target="_blank" rel="noopener" data-event="directions_click" data-label="map">Get directions in Google Maps</a></p>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-map-load]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const frame = btn.closest('[data-map-frame]') as HTMLElement;
      const f = document.createElement('iframe');
      f.src = btn.dataset.src!;
      f.title = 'Map showing the restaurant location';
      f.loading = 'lazy';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      f.style.cssText = 'border:0;width:100%;height:100%;border-radius:.7rem';
      frame.replaceChildren(f);
    });
  });
</script>
