# Copy to .env and fill in. Never commit .env.

# Canonical domain, no trailing slash (required for production build)
PUBLIC_SITE_URL=https://www.example.com

# Google Analytics 4 measurement ID (tracking is OFF if empty)
PUBLIC_GA4_ID=

# Booking form endpoint (Web3Forms-compatible). Form is shown but cannot submit if empty.
PUBLIC_BOOKING_ENDPOINT=https://api.web3forms.com/submit
# Web3Forms access key (public by design; restrict it to your domain in the Web3Forms dashboard)
PUBLIC_BOOKING_ACCESS_KEY=

# IndexNow (optional). Any 8-128 char hex/alnum string. No key = script skips.
INDEXNOW_KEY=

# Set to 1 to build a noindex, robots-blocked preview that bypasses the facts gate
# (use `npm run build:draft`, never deploy it as the public site)
PUBLIC_DRAFT_MODE=
